# Production site URL used for canonical links, sitemap.xml, and robots.txt.
# Required in Cloudflare/production: https://devs-forge.com
NEXT_PUBLIC_SITE_URL=https://devs-forge.com

# Set to "true" to log warnings when NEXT_PUBLIC_SITE_URL differs from devs-forge.com
# SEO_STRICT_SITE_URL=true

# Set to "true" to disable Content-Security-Policy in production (debugging only)
# SECURITY_CSP_DISABLE=true
